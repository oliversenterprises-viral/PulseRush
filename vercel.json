{
  "rewrites": [
    { "source": "/", "destination": "/www/index.html" },
    { "source": "/privacy", "destination": "/www/privacy.html" },
    { "source": "/privacy.html", "destination": "/www/privacy.html" },
    { "source": "/stats", "destination": "/www/stats.html" },
    { "source": "/stats.html", "destination": "/www/stats.html" },
    { "source": "/manifest.webmanifest", "destination": "/www/manifest.webmanifest" },
    { "source": "/css/:path*", "destination": "/www/css/:path*" },
    { "source": "/js/:path*", "destination": "/www/js/:path*" },
    { "source": "/assets/:path*", "destination": "/www/assets/:path*" },
    { "source": "/og.png", "destination": "/www/assets/og.png" },
    { "source": "/api/:path*", "destination": "/api/:path*" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300" }
      ]
    },
    {
      "source": "/stats",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/stats.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/api/stats",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/api/pulse",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
